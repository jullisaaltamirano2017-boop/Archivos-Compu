import "platform:/resource/GeneradorB/model/generadorB.ecore" 
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

Raiz returns Raiz:
	'Proyecto'
	name=EString
	'{'
		 entidad+=Entidad (entidad+=Entidad)* 
	'}';



EString returns ecore::EString:
	STRING | ID;

Entidad returns Entidad:
	'Entidad'
	name=EString
	'{'
		  campo+=Campo ( "," campo+=Campo)*
	'}';

Campo returns Campo:
	
	name=EString
		(tipo=TipoDato)
		(principal=EBoolean)?
		(entidad=[Entidad|EString])?;

enum TipoDato returns TipoDato:
				entero = 'entero' | decimal = 'decimal' 
				| logico = 'logico' | cadena = 'cadena' 
				| fecha = 'fecha' | caracter = 'caracter'
				| hora = 'tiempo'| fechahora = 'fechahora';

EBoolean returns ecore::EBoolean:
	'true' | 'false';
